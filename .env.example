# Copy this file to ".env" and fill in your values.
# The .env file is gitignored and never committed.

# Free-tier Gemini API key from https://aistudio.google.com/apikey
# Leave blank to run PawPal+ in deterministic fallback mode (no AI calls).
GEMINI_API_KEY=

# Gemini model to use (free tier friendly default).
PAWPAL_MODEL=gemini-2.5-flash

# Agent guardrails.
PAWPAL_MAX_ITERATIONS=3
PAWPAL_MAX_TASKS=20
