classDiagram
    class TimeWindow {
        +int start_minute
        +int end_minute
        +duration_minutes()
        +contains(minute)
        +overlaps(other)
    }

    class SchedulingConstraints {
        +int available_minutes
        +list preferred_windows
        +list blocked_windows
        +int max_tasks
    }

    class Owner {
        +string name
        +string preferences
        +int available_time_minutes
        +string notes
        +update_preferences(preferences)
        +set_available_time(minutes)
        +add_pet(pet)
    }

    class Pet {
        +string name
        +string species
        +string breed
        +int age
        +string care_notes
        +Owner owner
        +list tasks
        +update_profile(name, species, breed, age)
        +add_task(task)
        +get_summary()
    }

    class Task {
        +string title
        +int duration_minutes
        +string priority
        +string category
        +string recurrence
        +TimeWindow preferred_window
        +Pet pet
        +bool completed
        +is_valid()
        +get_priority_score()
        +mark_complete()
        +can_fit_into(time_remaining)
    }

    class DayPlan {
        +date date
        +int available_minutes
        +Owner owner
        +Pet pet
        +list scheduled_items
        +add_item(item)
        +get_total_scheduled_minutes()
        +get_remaining_minutes()
        +explain_plan()
    }

    class ScheduleItem {
        +Task task
        +TimeWindow window
        +string reason
        +format_entry()
        +conflicts_with(other)
    }

    class Scheduler {
        +Owner owner
        +Pet pet
        +list tasks
        +SchedulingConstraints constraints
        +generate_schedule()
        +rank_tasks()
        +check_constraints()
        +resolve_conflicts()
    }

    Owner --> SchedulingConstraints : uses
    Owner --> Pet : cares for
    Owner --> Scheduler : uses
    Pet --> Task : owns tasks
    Task --> TimeWindow : prefers
    Scheduler --> Task : evaluates
    Scheduler --> DayPlan : creates
    DayPlan --> ScheduleItem : contains
    ScheduleItem --> Task : wraps
    ScheduleItem --> TimeWindow : schedules within
