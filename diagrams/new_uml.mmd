classDiagram
    %% ---------------- Deterministic core (pawpal_system.py) ----------------
    class TimeWindow {
        +int start_minute
        +int end_minute
        +duration_minutes() int
        +contains(minute) bool
        +overlaps(other) bool
    }

    class SchedulingConstraints {
        +int available_minutes
        +list~TimeWindow~ preferred_windows
        +list~TimeWindow~ blocked_windows
        +int max_tasks
    }

    class Owner {
        +string name
        +string preferences
        +int available_time_minutes
        +string notes
        +list~Pet~ pets
        +update_preferences(preferences)
        +set_available_time(minutes)
        +add_pet(pet)
    }

    class Pet {
        +string name
        +string species
        +string breed
        +int age
        +string care_notes
        +Owner owner
        +list~Task~ tasks
        +update_profile(name, species, breed, age)
        +add_task(task)
        +get_summary() str
    }

    class Task {
        +string title
        +int duration_minutes
        +string priority
        +string category
        +string recurrence
        +string time
        +date due_date
        +TimeWindow preferred_window
        +Pet pet
        +bool completed
        +is_valid() bool
        +get_priority_score() int
        +mark_complete()
        +get_next_occurrence() Task
        +can_fit_into(time_remaining) bool
        +from_dict(data, pet)$ Task
    }

    class ScheduleItem {
        +Task task
        +TimeWindow window
        +string reason
        +format_entry() str
        +conflicts_with(other) bool
    }

    class DayPlan {
        +date date
        +int available_minutes
        +Owner owner
        +Pet pet
        +list~ScheduleItem~ scheduled_items
        +add_item(item)
        +get_total_scheduled_minutes() int
        +get_remaining_minutes() int
        +explain_plan() str
    }

    class Scheduler {
        +Owner owner
        +Pet pet
        +list~Task~ tasks
        +SchedulingConstraints constraints
        +sort_by_time(tasks) list
        +filter_tasks(pet_name, completed, tasks) list
        +mark_task_complete(task) Task
        +detect_conflicts(tasks) list
        +rank_tasks() list
        +check_constraints() bool
        +resolve_conflicts()
        +generate_schedule() DayPlan
    }

    %% ---------------- Agentic AI layer (agent/) ----------------
    class PawPalAgent {
        +Settings settings
        +GeminiClient client
        +run(nl_text, pet, owner, available_minutes) AgentResult
        -_plan(...) tuple
        -_act(...) tuple
        -_check(...) tuple
    }

    class AgentResult {
        +list~Task~ proposed_tasks
        +DayPlan day_plan
        +dict critique
        +list~str~ guardrail_findings
        +int iterations
        +bool used_fallback
        +list~AgentStep~ trace
    }

    class AgentStep {
        +string phase
        +int iteration
        +string detail
    }

    class GeminiClient {
        +bool available
        +plan(system, prompt) any
        +critique(system, prompt) any
    }

    class Settings {
        +string gemini_api_key
        +string model
        +int max_iterations
        +int max_tasks
        +has_api_key() bool
    }

    %% ---------------- Relationships ----------------
    Owner "1" --> "*" Pet : cares for
    Pet "1" --> "*" Task : owns tasks
    Task --> TimeWindow : prefers
    Scheduler --> Owner : uses
    Scheduler --> Pet : schedules for
    Scheduler --> Task : evaluates
    Scheduler --> SchedulingConstraints : constrained by
    Scheduler --> DayPlan : creates
    DayPlan --> ScheduleItem : contains
    ScheduleItem --> Task : wraps
    ScheduleItem --> TimeWindow : scheduled within

    PawPalAgent --> Settings : configured by
    PawPalAgent --> GeminiClient : PLAN + CHECK
    PawPalAgent --> Scheduler : ACT (delegates math)
    PawPalAgent --> AgentResult : produces
    AgentResult --> AgentStep : trace of
    AgentResult --> DayPlan : final plan
    AgentResult --> Task : proposed tasks
